# DayWeave — Environment Variables Template
# Optional: If you leave these blank, DayWeave runs seamlessly in 100% Local-First Offline Mode.
# To enable multi-device Cloud Sync and Google Authentication, create a Firebase project at https://console.firebase.google.com and fill in the values below:

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
